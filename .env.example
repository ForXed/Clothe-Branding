# ---------------------------------------------------------------------------
# Copy to .env.development (or .env.local for machine-specific overrides).
# Vite exposes only variables prefixed with VITE_ to the browser bundle.
# ---------------------------------------------------------------------------

# API origin only - the client appends /api/v1 itself.
# Local backend: run `run-local.cmd` in the BrutigeBackend repo (port 8080).
# Google OAuth is host-root (/oauth2/authorization/google), not under /api/v1.
VITE_API_URL=http://localhost:8080

# Order chat (GET/POST /api/v1/orders/{orderId}/messages) is not shipped by the
# backend yet - the devs own it. Keep this false so the entry points stay hidden;
# flip it to true once their REST pair lands and the surface is verified.
VITE_FEATURE_CHAT=false

# Tunnel mode: the SPA and the API share one public hostname (the tunnel routes
# /api, /oauth2, /v3 ... to port 8080 and everything else to Vite), so the base
# URL has to be that origin instead of localhost. Same-origin also means the
# access/refresh cookies stay first-party.
VITE_API_URL=https://brutige.name.ng
VITE_FEATURE_CHAT=false